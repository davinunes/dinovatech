# ==========================================
# Dinovatech - Configurações de Ambiente
# ==========================================

# Aplicação e Chave Mestra (32 bytes hexadecimais para criptografia AES-256-GCM)
APP_MASTER_KEY=
APP_MODE_VET=true
TZ=America/Sao_Paulo

# Banco de Dados Principal (MariaDB)
DB_HOSTNAME=127.0.0.1
DB_DATABASE=dinovatech
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=UTF8

# Microserviço WeasyPrint (Geração de PDFs Sidecar)
WEASYPRINT_URL=http://127.0.0.1:9080/convert/html

# ==========================================
# Módulo SaaS Master & Orquestração K3s
# ==========================================
# Ative para habilitar o painel de tenants e cluster K3s nesta instância
SAAS_MASTER_ENABLED=false

# Endpoint da API REST do Kubernetes K3s
K3S_API_URL=https://137.131.208.19:6443

# Token Bearer de longa duração gerado para o dinovatech-saas-admin
K3S_API_TOKEN=

# Ignorar validação estrita de certificado SSL do cluster (recomendado se IP direto)
K3S_INSECURE_SKIP_TLS=true

# Imagem Docker padrão dos Pods de novos clientes
K3S_DEFAULT_IMAGE=dinovatech:latest
